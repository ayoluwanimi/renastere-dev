# Neon Database Configuration
# Get your NETLIFY_DATABASE_URL from:
# 1. Neon Console: https://console.neon.tech
# 2. Copy the connection string
# 3. Add it to Netlify environment variables at: https://app.netlify.com/sites/renasteredev.online/settings/deploys#environment

NETLIFY_DATABASE_URL=postgresql://user:password@ep-xxxxx.region.neon.tech/dbname

# Other environment variables
VITE_API_URL=http://localhost:8888
